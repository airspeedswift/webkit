WK_NO_STATIC_INITIALIZERS_Release_NO_ = $(WK_ERROR_WHEN_LINKING_WITH_STATIC_INITIALIZERS);
WK_NO_STATIC_INITIALIZERS_Production__ = $(WK_ERROR_WHEN_LINKING_WITH_STATIC_INITIALIZERS);
WK_NO_STATIC_INITIALIZERS_Production_NO_ = $(WK_ERROR_WHEN_LINKING_WITH_STATIC_INITIALIZERS);

WK_DEBUG_LDFLAGS =
WK_DEBUG_LDFLAGS[config=Debug] = -Wl,-debug_variant

JSC_SEC_LD_FLAGS[sdk=iphoneos*] = -weak_framework BrowserEngineCore;
JSC_SEC_LD_FLAGS[sdk=macosx*] = -weak_framework BrowserEngineCore;
JSC_SEC_LD_FLAGS[sdk=appletv*] = ;
JSC_SEC_LD_FLAGS[sdk=watch*] = ;
JSC_SEC_LD_FLAGS[sdk=xr*] = ;

// FIXME: Reduce the number of allowable_clients <rdar://problem/31823969>
WEBCORE_ALLOWABLE_CLIENTS = $(WEBCORE_ALLOWABLE_CLIENTS_$(WK_NOT_$(ENABLE_LIBFUZZER)));
WEBCORE_ALLOWABLE_CLIENTS_YES = -allowable_client WebCoreTestSupport -allowable_client WebKitLegacy -allowable_client WebKit -allowable_client TestIPC -allowable_client TestWebKitAPI -allowable_client TestWebKitAPIPlugIn -allowable_client DumpRenderTree -allowable_client WebKitTestRunner $(WEBCORE_ALLOWABLE_CLIENTS_PLATFORM_$(WK_COCOA_TOUCH));
WEBCORE_ALLOWABLE_CLIENTS_PLATFORM_cocoatouch = -allowable_client iTunesU -allowable_client Casablanca -allowable_client Remote -allowable_client TVBooks;

// Thin LTO: no cross-module function import into WebCore's modules. With the Swift snapshot's assertions-enabled libLTO,
// importing into WebCore's C++ modules aborts the link: "!(Pair.first != Ty && Pair.second == Ty) && mapping to a source
// type" (IRMover.cpp, TypeMapTy::get, from FunctionImporter::importFunctions while remapping instruction metadata).
OTHER_LDFLAGS_THIN_LTO_IMPORT = $(OTHER_LDFLAGS_THIN_LTO_IMPORT_$(LLVM_LTO));
OTHER_LDFLAGS_THIN_LTO_IMPORT_YES_THIN = -Wl,-mllvm,-import-instr-limit=0;

// Work around rdar://139232237 / rdar://165050676 by hiding all exported symbols from the "Cxx" module, as WebGPU and
// WebKit do. WebCore's Swift links them in.
WK_UNEXPORT_SWIFT_CXX_LDFLAGS = -Wl,-unexported_symbol,_$s*3Cxx*;

OTHER_LDFLAGS = $(inherited) $(OTHER_LDFLAGS_SHARED_CACHE) $(JSC_SEC_LD_FLAGS) $(WK_UNEXPORT_SWIFT_CXX_LDFLAGS) -weak-lxslt -lsqlite3 -lobjc $(WEBCORE_ALLOWABLE_CLIENTS) -force_load $(BUILT_PRODUCTS_DIR)/libPAL.a -lswiftCore -framework CFNetwork -framework CoreAudio -framework CoreGraphics -framework CoreText -framework Foundation -framework IOSurface -framework ImageIO -framework Metal -framework Network -lFontParser $(OTHER_LDFLAGS_PLATFORM_$(WK_PLATFORM_NAME)) $(WK_ANGLE_LDFLAGS) $(WK_WEBGPU_LDFLAGS) $(WK_APPKIT_LDFLAGS) $(WK_APPSUPPORT_LDFLAGS) $(WK_AUDIO_UNIT_LDFLAGS) $(WK_CARBON_LDFLAGS) $(WK_CORE_UI_LDFLAGS) $(WK_DATA_DETECTORS_CORE_LDFLAGS) $(WK_GRAPHICS_SERVICES_LDFLAGS) $(WK_IOSURFACE_ACCELERATOR_LDFLAGS) $(WK_LIBWEBRTC_LDFLAGS) $(WK_MOBILE_CORE_SERVICES_LDFLAGS) $(WK_MOBILE_GESTALT_LDFLAGS) $(WK_NETWORK_EXTENSION_LDFLAGS) $(WK_SYSTEM_CONFIGURATION_LDFLAGS) $(WK_CORE_IMAGE_LDFLAGS) $(WK_URL_FORMATTING_LDFLAGS) $(WK_UNIFORM_TYPE_IDENTIFIERS_LDFLAGS) $(SOURCE_VERSION_LDFLAGS) $(WK_CLANG_PGO_USE_LDFLAGS) $(WK_CLANG_PGO_GEN_FLAGS) $(WK_NO_STATIC_INITIALIZERS) $(WK_DEBUG_LDFLAGS) $(LLVM_PROFILE_GENERATION_OTHER_LD_FLAGS) $(OTHER_LDFLAGS_THIN_LTO_IMPORT) $(WK_SWIFT_CF_TYPE_ID_LDFLAGS) -force_load $(BUILT_PRODUCTS_DIR)/libWebCoreSwiftSupport.a -force_load $(BUILT_PRODUCTS_DIR)/libWebCoreEME.a $(WK_WEBGL_ISLAND_LDFLAGS);

OTHER_LDFLAGS_PLATFORM_macosx = -sub_library libobjc $(WK_CLANG_PGO_USE_LDFLAGS) $(WK_CLANG_PGO_GEN_FLAGS);

// Use order files from WebKitAdditions for internal SDK macOS production builds
WK_ORDER_FILE = $(WK_WEBKITADDITIONS_HEADERS_FOLDER_PATH)/OrderFiles/WebCore.order.txt;
WK_ENABLE_ORDER_FILE = $(WK_ENABLE_ORDER_FILE_$(USE_INTERNAL_SDK)_$(CONFIGURATION)_$(WK_PLATFORM_NAME));
WK_ENABLE_ORDER_FILE_YES_Production_macosx = YES;
WK_ORDER_FILE_LDFLAGS = $(WK_ORDER_FILE_LDFLAGS_$(WK_ENABLE_ORDER_FILE));
WK_ORDER_FILE_LDFLAGS_YES = -Wl,-order_file,$(WK_ORDER_FILE);
SECTORDER_FLAGS = $(WK_ORDER_FILE_LDFLAGS);

EXCLUDED_SOURCE_FILE_NAMES = pdfjs*/*;
EXCLUDED_SOURCE_FILE_NAMES[sdk=iphone*] = $(inherited) *.tiff *Cursor.png npapi.h npfunctions.h npruntime.h npruntime_internal.h;
EXCLUDED_SOURCE_FILE_NAMES[sdk=xr*] = $(inherited) *.tiff *Cursor.png npapi.h npfunctions.h npruntime.h npruntime_internal.h modelDefaultDiffuseData modelDefaultSpecularData;

INCLUDED_SOURCE_FILE_NAMES = $(INCLUDED_SOURCE_FILE_NAMES_$(ENABLE_PDFJS));
INCLUDED_SOURCE_FILE_NAMES_ENABLE_PDFJS = pdfjs*/*;

ALLOW_SHARED_CACHE = $(ALLOW_SHARED_CACHE_$(WK_RELOCATABLE_FRAMEWORKS)_$(USE_STAGING_INSTALL_PATH)_$(WK_PLATFORM_NAME));
ALLOW_SHARED_CACHE_YES_YES_macosx = NO;
ALLOW_SHARED_CACHE_YES__macosx = NO;
ALLOW_SHARED_CACHE__YES_macosx = NO;

OTHER_LDFLAGS_SHARED_CACHE = $(OTHER_LDFLAGS_SHARED_CACHE_$(ALLOW_SHARED_CACHE));
OTHER_LDFLAGS_SHARED_CACHE_NO = -Wl,-not_for_dyld_shared_cache;

OTHER_CPLUSPLUSFLAGS = $(inherited) -fmodules -fno-cxx-modules;

// Enable InstallAPI support, when built with WEBCORE_ENABLE_INSTALLAPI=YES.
SUPPORTS_TEXT_BASED_API = $(SUPPORTS_TEXT_BASED_API_$(WK_ENABLE_SLOW_BUILD_VERIFICATION)_$(TARGET_NAME));
SUPPORTS_TEXT_BASED_API_YES_WebCore = $(WEBCORE_ENABLE_INSTALLAPI);
TAPI_USE_SRCROOT = YES;
TEXT_BASED_API_FILE = WebCore.tbd

// audit-spi normally only runs when SUPPORTS_TEXT_BASED_API is enabled.
// WebCore does not build with InstallAPI by default, and unlike other frameworks
// in our stack, its API surface is fully discoverable through binary analysis.
WK_AUDIT_SPI[sdk=iphoneos*] = $(WK_AND_$(WK_DEFAULT_WK_AUDIT_SPI)_$(WK_NOT_$(WK_ANY_SANITIZER_ENABLED)));
WK_AUDIT_SPI_ALLOWLISTS = $(SRCROOT)/Configurations/AllowedSPI.toml $(SRCROOT)/Configurations/AllowedSPI-legacy.toml $(WK_AUDIT_SPI_ALLOWLISTS_$(USE_INTERNAL_SDK));
WK_AUDIT_SPI_ALLOWLISTS_YES = $(WK_WEBKITADDITIONS_HEADERS_FOLDER_PATH)/AllowedSPI/AllowedSPI-WebCore.toml;

// Without it, a call to a generic function in another Swift file is never specialized.
SWIFT_COMPILATION_MODE = wholemodule;

SWIFT_INSTALL_OBJC_HEADER = NO;
// FIXME: Set `BUILD_LIBRARY_FOR_DISTRIBUTION` to `NO` when possible.
BUILD_LIBRARY_FOR_DISTRIBUTION = YES;
SWIFT_LIBRARY_LEVEL = spi;
_SWIFT_EXPLICIT_MODULES_ALLOW_CXX_INTEROP = YES;
SWIFT_OBJC_INTEROP_MODE = objcxx;

SWIFT_OBJC_INTERFACE_HEADER_NAME = WebCoreSwift-Generated.h;

// Whether WebCore's Swift is compiled and its C++ calls it, for C++ and Swift alike (CMake sets it on
// every Apple port). Outside macOS it needs Swift 6.4, which comes with the 27 SDKs.
ENABLE_WEBCORE_SWIFT = ENABLE_WEBCORE_SWIFT;
ENABLE_WEBCORE_SWIFT[sdk=*26*] = ;

MODULEMAP_FILE = $(SRCROOT)/WebCore.modulemap;
MODULEMAP_PRIVATE_FILE = $(SRCROOT)/WebCore_Private.modulemap;

WK_VERIFY_WEBCORE_MODULE = $(WK_ENABLE_MODULE_VERIFIER);
WK_ENABLE_MODULE_VERIFIER = YES;
// Module requires bug fixes that shipped in 26.4.
WK_ENABLE_MODULE_VERIFIER[sdk=*26.2*] = ;
WK_ENABLE_MODULE_VERIFIER[sdk=*26.3*] = ;
// Disabled on internal builds of macOS due to rdar://175057536.
WK_ENABLE_MODULE_VERIFIER[sdk=macosx*.internal] = ;

ENABLE_MODULE_VERIFIER = $(ENABLE_MODULE_VERIFIER_$(WK_ENABLE_SLOW_BUILD_VERIFICATION));
ENABLE_MODULE_VERIFIER_YES = $(WK_VERIFY_WEBCORE_MODULE);
MODULE_VERIFIER_SUPPORTED_LANGUAGES = objective-c++;
MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS = c++23;
MODULE_VERIFIER_KIND = builtin;

// -fno-exceptions matches GCC_ENABLE_CPP_EXCEPTIONS = NO, so C++ inline functions that Swift calls can be inlined into it.
// -fignore-exceptions keeps the cleanups Objective-C exceptions (GCC_ENABLE_OBJC_EXCEPTIONS) would need out of the C++
// inline functions Swift calls, so they can be inlined too.
// -O2 compiles those inline C++ functions as WebCore's C++ is, not at the importer's default -Os, so their loops
// vectorize. Debug leaves them unoptimized, as it leaves WebCore's C++: Swift's -Onone pipeline does not remove the ARC
// markers clang's optimized code generation emits, and the backend cannot select them.
// With the internal SDK, clang adds -fno-builtin-calloc and -fno-builtin-stpcpy to every compile, the importer's
// included, so each C++ function carries those two no-builtin attributes, and LLVM inlines a function only into a caller
// that has them too. -default-function-attr gives them to Swift's functions as well, so the C++ inline functions they
// call can be inlined.
// -enable-dfa-jump-thread lets LLVM branch from each transition of a state machine written as a switch in a loop
// straight to the next state.
// BuiltinModule is for the vendored SIMD operations in SIMD*.swift, until the standard library has them.
// Swift zero-initializes a C++ type with no default constructor and only warns that this is deprecated; such a
// value can hold a null pointer the type never allows, so WebCore's Swift treats that warning as an error.
// WebCore soft-links AVFoundation and CoreMedia, so its Swift doesn't autolink them or their overlays; it takes their
// classes and constants from PAL's getters (pal/cocoa/AVFoundationSoftLink.h), and a stray use of their symbols fails
// the link.
WK_SOFT_LINKED_FRAMEWORKS_SWIFT_FLAGS = -Xfrontend -disable-autolink-framework -Xfrontend AVFAudio -Xfrontend -disable-autolink-library -Xfrontend swiftAVFAudio -Xfrontend -disable-autolink-framework -Xfrontend AVFoundation -Xfrontend -disable-autolink-library -Xfrontend swiftAVFoundation -Xfrontend -disable-autolink-framework -Xfrontend AudioToolbox -Xfrontend -disable-autolink-library -Xfrontend swiftAudioToolbox -Xfrontend -disable-autolink-framework -Xfrontend AudioToolboxCore -Xfrontend -disable-autolink-library -Xfrontend swiftAudioToolboxCore -Xfrontend -disable-autolink-framework -Xfrontend CoreML -Xfrontend -disable-autolink-library -Xfrontend swiftCoreML -Xfrontend -disable-autolink-framework -Xfrontend CoreMedia -Xfrontend -disable-autolink-library -Xfrontend swiftCoreMedia -Xfrontend -disable-autolink-framework -Xfrontend MediaToolbox -Xfrontend -disable-autolink-library -Xfrontend swiftMediaToolbox -Xfrontend -disable-autolink-framework -Xfrontend ScreenCaptureKit -Xfrontend -disable-autolink-library -Xfrontend swiftScreenCaptureKit -Xfrontend -disable-autolink-framework -Xfrontend Vision -Xfrontend -disable-autolink-library -Xfrontend swiftVision -Xfrontend -disable-autolink-framework -Xfrontend VideoToolbox -Xfrontend -disable-autolink-library -Xfrontend swiftVideoToolbox -Xfrontend -disable-autolink-library -Xfrontend swiftCompression -Xfrontend -disable-autolink-library -Xfrontend compression -I $(BUILT_PRODUCTS_DIR)/DerivedSources/WebCore/SoftLinkAccessors/PALSoftLinkTypes;
// Newer Swift compilers reference a Core Foundation type's GetTypeID function from its type metadata, so WebCore's Swift
// refers to CoreMedia's CMSampleBufferGetTypeID and CMFormatDescriptionGetTypeID directly, not through its soft links.
WK_SWIFT_CF_TYPE_ID_LDFLAGS = -weak_framework CoreMedia;
// Swift's importer reads C++ headers' bounds attributes, as in the CMake build (WebKitSwiftFlags.cmake).
WK_SWIFT_BOUNDS_SAFETY_ATTRIBUTES_FLAGS = -Xcc -fexperimental-bounds-safety-attributes -Xcc -fexperimental-late-parse-attributes;

// ShapeDetectionVision.swift imports Vision, which WebCore soft-links: keep Vision, and the Swift overlays that only its
// import brings, out of WebCore's load commands.

// The WebGL island (WebCoreWebGL.xcconfig): WebCore force-loads it, its C++ includes the headers beside its module maps,
// and its Swift (GraphicsContextGLANGLE.swift, GraphicsContextGLCocoa.swift) imports its Swift module. WebKit's Swift
// calls its Swift, so that is exported; GLIslandCalls, which the island implements for GraphicsContextGLANGLE, is
// WebCore's only.
WK_WEBGL_ISLAND_LDFLAGS = -force_load $(BUILT_PRODUCTS_DIR)/libWebCoreWebGL.a $(WK_WEBGL_ISLAND_UNEXPORT_LDFLAGS);
WK_WEBGL_ISLAND_UNEXPORT_LDFLAGS = -Wl,-unexported_symbol,__ZN*7WebCore13GLIslandCalls*;
WK_WEBGL_ISLAND_HEADER_SEARCH_PATHS = $(SRCROOT)/platform/graphics/angle/swift $(CONFIGURATION_TEMP_DIR)/WebCoreWebGL.build/DerivedSources;
WK_WEBGL_ISLAND_SWIFT_FLAGS = -I $(CONFIGURATION_TEMP_DIR)/WebCoreWebGL.build/Objects-normal/$(CURRENT_ARCH);
// Xcode passes SYSTEM_FRAMEWORK_SEARCH_PATHS to Swift as ordinary framework search paths, so Swift's importer
// would build private frameworks' modules as user headers, and reject their exceptions under -fno-exceptions.
WK_SWIFT_SYSTEM_FRAMEWORK_FLAGS = -Xcc -iframework$(WK_PRIVATE_SDK_DIR)$(SYSTEM_LIBRARY_DIR)/PrivateFrameworks;
WK_SWIFT_IMPORTED_CXX_OPTIMIZATION_FLAGS = -Xcc -O2;
WK_SWIFT_IMPORTED_CXX_OPTIMIZATION_FLAGS[config=Debug] = ;
WK_SWIFT_IMPORTED_CXX_NO_BUILTIN_FLAGS = $(WK_SWIFT_IMPORTED_CXX_NO_BUILTIN_FLAGS_$(USE_INTERNAL_SDK));
WK_SWIFT_IMPORTED_CXX_NO_BUILTIN_FLAGS_YES = -Xcc -Xclang -Xcc -default-function-attr -Xcc -Xclang -Xcc no-builtin-calloc -Xcc -Xclang -Xcc -default-function-attr -Xcc -Xclang -Xcc no-builtin-stpcpy;
OTHER_SWIFT_FLAGS = $(inherited) -Werror DeprecatedDeclaration -Xcc -std=c++2b -Xcc -fno-exceptions -Xcc -fignore-exceptions $(WK_SWIFT_SYSTEM_FRAMEWORK_FLAGS) $(WK_SWIFT_IMPORTED_CXX_OPTIMIZATION_FLAGS) $(WK_SWIFT_IMPORTED_CXX_NO_BUILTIN_FLAGS) -Xllvm -enable-dfa-jump-thread -Xfrontend -clang-header-expose-decls=has-expose-attr-or-stdlib -Xfrontend -emit-clang-header-min-access -Xfrontend internal -enable-experimental-feature BuiltinModule -Werror SendableClosureCaptures $(WK_SWIFT_PGO_USE_FLAGS) $(WK_SWIFT_PGO_GEN_FLAGS) @$(BUILT_PRODUCTS_DIR)/DerivedSources/WebCore/platform-enabled-swift-args.$(arch).resp $(WK_SWIFT_BOUNDS_SAFETY_ATTRIBUTES_FLAGS) -enable-experimental-feature BorrowInout -enable-experimental-feature BorrowAndMutateAccessors -enable-experimental-feature AddressableParameters -enable-experimental-feature CxxImplementation $(WK_SOFT_LINKED_FRAMEWORKS_SWIFT_FLAGS) $(WK_WEBCOREEME_TBD_FLAGS_$(ENABLE_WEBCORE_SWIFT)) $(WK_WEBGL_ISLAND_SWIFT_FLAGS);
// WebCore.framework exports WebCoreSwiftSupport's symbols (WebCoreSwiftSupport.xcconfig), so its TBD lists them.
WK_WEBCOREEME_TBD_FLAGS_ENABLE_WEBCORE_SWIFT = -Xfrontend -embed-tbd-for-module -Xfrontend WebCoreSwiftSupport -Xfrontend -embed-tbd-for-module -Xfrontend WebCoreEME;
// Swift that holds C++ state must not let it reach another thread. Several of the diagnostics that catch that
// are warnings in Swift 6 mode outside any diagnostic group, so warnings are errors too.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES;
// The compile cache drops -Xcc options, so it is off for WebCore's Swift.
SWIFT_ENABLE_COMPILE_CACHE = NO;

SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated;
SWIFT_STRICT_CONCURRENCY = complete;
DEFINES_MODULE = YES;

OTHER_MODULE_VERIFIER_FLAGS = -- $(WK_AVAILABILITY_OVERLAY_FLAGS) -iframework $(BUILT_PRODUCTS_DIR)/SDKAdditions/System/Library/Frameworks -I$(BUILT_PRODUCTS_DIR)$(WK_LIBRARY_HEADERS_FOLDER_PATH) -I$(BUILT_PRODUCTS_DIR)$(WK_LIBRARY_HEADERS_FOLDER_PATH)/webrtc -I$(WK_PRIVATE_SDK_DIR)$(WK_ALTERNATE_WEBKIT_SDK_PATH)$(WK_LIBRARY_HEADERS_FOLDER_PATH)/webrtc  -I$(WK_ADDITIONAL_SDKS)$(WK_LIBRARY_HEADERS_FOLDER_PATH) $(OTHER_MODULE_VERIFIER_FLAGS_$(WK_EMPTY_$(WK_OVERRIDE_FRAMEWORKS_DIR)));
OTHER_MODULE_VERIFIER_FLAGS_ = -iframework "$(WK_PRIVATE_SDK_DIR)$(WK_OVERRIDE_FRAMEWORKS_DIR)" -isystem "$(WK_PRIVATE_SDK_DIR)$(WK_ALTERNATE_WEBKIT_SDK_PATH)$(WK_LIBRARY_HEADERS_FOLDER_PATH)";

HEADERMAP_INCLUDES_FRAMEWORK_ENTRIES_FOR_TARGETS_NOT_BEING_BUILT = NO;
HEADERMAP_USES_VFS = YES;

// PSHUFB in SIMDTableLookup.swift needs SSSE3, which every x86_64 Mac target has. Other
// conditions are added to this line; assigning the setting again would replace it.
WK_SWIFT_SIMD_CONDITIONS[arch=x86_64] = HAVE_SSSE3;
// The scroll physics' Swift is compiled under the conditions of the C++ it replaced, which PlatformEnableCocoa.h sets.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(WK_SWIFT_SIMD_CONDITIONS) $(ENABLE_WEBCORE_SWIFT) ENABLE_ASYNC_SCROLLING ENABLE_KINETIC_SCROLLING;
