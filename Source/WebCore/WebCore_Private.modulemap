framework module WebCore_Private [system] {
    module PlatformExportMacros {
        header "PlatformExportMacros.h"
        export *
    }

    module Core {
        // Workaround for rdar://173516139: PrivateHeaders includes a header
        // "WorkAround173516139.h" that the build system regenerates whenever
        // the header list changes.
        umbrella "PrivateHeaders"

        requires cplusplus

        // These headers are also present in WebKitLegacy's PrivateHeaders. When
        // <Foundation/NSGeometry.h> is unavailable (i.e. when building against a
        // public SDK), WAKAppKitStubs.h declares its own NSPoint/NSRect/NSSize,
        // so each module would get its own definitions of the WAK classes and
        // fail the cross-module ODR check. Let WebKitLegacy own them.
        exclude header "WAKAppKitStubs.h"
        exclude header "WAKClipView.h"
        exclude header "WAKResponder.h"
        exclude header "WAKScrollView.h"
        exclude header "WAKView.h"
        exclude header "WAKWindow.h"

        // Excludes handled in explicit submodules below.
        exclude header "AudioDSPBoundaryTypes.h"

        // Defines a category on NSView, which WAKAppKitStubs.h maps to WAKView
        // on iOS, so it needs the definition of the class excluded above.
        exclude header "WebCoreView.h"

        // Private for TestWebKitAPI's audio benchmarks only. Their classes declare
        // reference counting and render-thread members that are not marked unsafe
        // for Swift, so they stay out of the module.
        exclude header "AudioContext.h"
        exclude header "AudioContextState.h"
        exclude header "AudioDestinationNode.h"
        exclude header "AudioDSPKernel.h"
        exclude header "AudioDSPKernelProcessor.h"
        exclude header "AudioNode.h"
        exclude header "AudioParam.h"
        exclude header "AudioParamTimeline.h"
        exclude header "AudioProcessor.h"
        exclude header "AudioResampler.h"
        exclude header "AudioSinkInfo.h"
        exclude header "AudioSinkOptions.h"
        exclude header "AudioSinkType.h"
        exclude header "AudioSummingJunction.h"
        exclude header "AutomationRate.h"
        exclude header "BaseAudioContext.h"
        exclude header "BiquadProcessor.h"
        exclude header "ChannelCountMode.h"
        exclude header "ChannelInterpretation.h"
        exclude header "DefaultAudioDestinationNode.h"
        exclude header "DelayProcessor.h"
        exclude header "IIRProcessor.h"
        exclude header "MultiChannelResampler.h"
        exclude header "NoiseInjectionPolicy.h"
        exclude header "OfflineAudioContext.h"
        exclude header "OfflineAudioDestinationNode.h"
        exclude header "OscillatorType.h"
        exclude header "PeriodicWaveConstraints.h"
        exclude header "WaveShaperProcessor.h"

        module * {
            export *
        }
    }

    explicit module AudioDSPBoundaryTypes {
        header "AudioDSPBoundaryTypes.h"
        export *
    }
}
